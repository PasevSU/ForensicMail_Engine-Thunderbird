root = true

# LF everywhere — see .gitattributes for why this is a contract, not a preference.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double spaces are a Markdown line break; never strip them by accident.
trim_trailing_whitespace = false
indent_size = 2

[*.ps1]
# PowerShell on Windows: keep the platform's own convention for new scripts while
# this repository's files stay LF. CRLF authored here would break the LF check.
end_of_line = lf

[*.{json,yml,yaml}]
indent_size = 2
