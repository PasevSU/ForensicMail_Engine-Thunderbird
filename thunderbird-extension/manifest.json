{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "1.9",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "pasevsu-forensic-headers@pasev.example",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "compose",
    "storage",
    "accountsRead"
  ],
  "icons": {
    "16": "icons/pasevsu-16.png",
    "32": "icons/pasevsu-32.png",
    "48": "icons/pasevsu-48.png",
    "128": "icons/pasevsu-128.png"
  },
  "browser_action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/pasevsu-16.png",
      "32": "icons/pasevsu-32.png",
      "48": "icons/pasevsu-48.png",
      "128": "icons/pasevsu-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
